# ==============================================================================
# Chetna - AI Flood Early-Warning System (B2 Alerts & Sensor Configuration)
# Copy this file to '.env' and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Twilio SMS & Voice Call Configuration
# Sign up at https://www.twilio.com/ to obtain Account SID and Auth Token
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# Create a bot with @BotFather on Telegram to get your token.
# To get your chat ID, message your bot or use @userinfobot or channel ID.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# System & Operational Settings
# ------------------------------------------------------------------------------
# Set to 'true' to simulate sending SMS/Telegram without calling real APIs
ALERT_DRY_RUN=true
ALERT_LOG_LEVEL=INFO
ALERT_RETRY_ATTEMPTS=3

# Database configuration (relative to repo root or absolute path)
DATABASE_PATH=data/chetna.db

# Sensor Simulator Thresholds (in centimeters)
WATER_LEVEL_WARNING_THRESHOLD_CM=75.0
WATER_LEVEL_CRITICAL_THRESHOLD_CM=120.0
RAINFALL_HOURLY_WARNING_MM=30.0
RAINFALL_HOURLY_CRITICAL_MM=60.0

# Emergency Fallback Phone Contacts (comma-separated E.164 numbers)
EMERGENCY_BROADCAST_NUMBERS=+919876543210,+919876543211
